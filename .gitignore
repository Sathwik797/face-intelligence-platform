# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/

# Environments
.env
.venv
env/
venv/
ENV/

# Datasets and Raw Biometric Face Images (Privacy Protection)
data/raw/
data/evaluation/
data/embeddings/
dataset/
*.jpg
*.jpeg
*.png
*.bmp
*.webp

# Preserve metadata directory structure
!data/
!data/metadata/
!data/metadata/**

# Preserve Evaluation, Calibration, Quality, Temporal & Presence Reports/Plots for Portfolio Evidence
!reports/
!reports/evaluation/
!reports/evaluation/plots/
!reports/evaluation/plots/*.png
!reports/evaluation/README.md
!reports/evaluation/verification_summary.json

!reports/calibration/
!reports/calibration/plots/
!reports/calibration/plots/*.png
!reports/calibration/README.md
!reports/calibration/calibration_summary.json

!reports/quality/
!reports/quality/plots/
!reports/quality/plots/*.png
!reports/quality/README.md
!reports/quality/quality_analysis_summary.json

!reports/temporal/
!reports/temporal/plots/
!reports/temporal/plots/*.png
!reports/temporal/README.md
!reports/temporal/temporal_analysis_summary.json

!reports/presence/
!reports/presence/plots/
!reports/presence/plots/*.png
!reports/presence/README.md
!reports/presence/presence_analysis_summary.json

# Large Model Weights and Binaries (>100MB / ONNX / Pickle / NPZ)
ml/models/*.onnx
*.onnx
trained_model/*.pkl
*.pkl
*.npz

# Exclude Evaluation, Calibration, Quality, Temporal & Presence Caches & Raw Pair CSVs
reports/evaluation/cache/
reports/evaluation/cache/**
reports/evaluation/pair_results_*.csv
reports/evaluation/*.csv

reports/calibration/cache/
reports/calibration/cache/**
reports/calibration/*.csv

reports/quality/cache/
reports/quality/cache/**
reports/quality/*.csv

reports/temporal/cache/
reports/temporal/cache/**
reports/temporal/*.csv

reports/presence/cache/
reports/presence/cache/**
reports/presence/*.csv

# Runtime output logs & CSVs
attendance.csv
attendence.csv

