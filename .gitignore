# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/

# Environments
.env
.venv
env/
venv/
ENV/

# Datasets and Raw Biometric Face Images (Privacy Protection)
data/raw/
data/evaluation/
data/embeddings/
dataset/
*.jpg
*.jpeg
*.png
*.bmp
*.webp

# Preserve metadata directory structure
!data/
!data/metadata/
!data/metadata/**

# Preserve Evaluation Reports and Plots for Portfolio / Recruiter Evidence
!reports/
!reports/evaluation/
!reports/evaluation/plots/
!reports/evaluation/plots/*.png
!reports/evaluation/README.md
!reports/evaluation/verification_summary.json

# Large Model Weights and Binaries (>100MB / ONNX / Pickle / NPZ)
ml/models/*.onnx
*.onnx
trained_model/*.pkl
*.pkl
*.npz

# Exclude Evaluation Biometric Embedding Caches & Raw Pair CSVs
reports/evaluation/cache/
reports/evaluation/cache/**
reports/evaluation/pair_results_*.csv
reports/evaluation/*.csv

# Runtime output logs & CSVs
attendance.csv
attendence.csv

# IDE / OS files
.DS_Store
Thumbs.db
.vscode/
.idea/
